DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=change-me-to-a-long-random-string

# Contact form email (any SMTP provider). Without these, messages are only saved to the database.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=G-fuel-ecommerce@proton.me

# Public site address, used in password reset links.
APP_URL=http://localhost:3001

# Set to true for hosted databases that require SSL. Leave false for local Docker Postgres.
DATABASE_SSL=false

# Docker only: password for the local database user "gfuel" (optional, has a dev default).
# POSTGRES_PASSWORD=change-me
